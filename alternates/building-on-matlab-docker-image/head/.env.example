# head ノード用の設定例。`.env` にコピーして値を書き換えてください。
# 使い方の詳細は ../../../README.fork.md を参照。

# --- 必須 ---
# authentik LDAP アウトポストのホスト名。未設定だと docker compose がエラー終了します。
LDAP_HOST=ldap.example.internal

# --- クラスタ設定（compute ノードと一致させる必要があるもの） ---
# ジョブマネージャ名。compute 側の JM_NAME と一致必須。
JM_NAME=MyMJS
# MJS セキュリティレベル。compute 側と一致必須（不一致だとワーカーが登録できません）。
# 2 未満は認証なしの root 実行になるため entrypoint が起動を拒否します（ALLOW_INSECURE_SECURITY_LEVEL=1 で解除）。
SECURITY_LEVEL=2
#ALLOW_INSECURE_SECURITY_LEVEL=0

# --- ホスト設定 ---
# mjs_def.sh の HOSTNAME に書き込まれます。DNS で解決できる名前を指定してください。
FQDN=head.example.internal

# --- LDAP ---
# 既定は LDAPS。ldap/389 にすると全ユーザーのパスワードが平文で流れます。
LDAP_SCHEME=ldaps
LDAP_PORT=636
# [username] が短いユーザー名に置換されます（角括弧が正式なトークン）。
# authentik 以外のディレクトリを使う場合は base DN を書き換えてください。
LDAP_PRINCIPAL_FORMAT=cn=[username],ou=users,dc=ldap,dc=goauthentik,dc=io
MJS_ADMIN_USER=mjsadmin
# LDAP 同期間隔（秒）。0 は毎アクセス時に同期。短いほどユーザー無効化が早く反映されます。
LDAP_SYNC_INTERVAL=1800

# --- 起動タイミング / リソース上限 ---
#MJS_START_DELAY=10
#MJS_PROMPT_TIMEOUT=180
#PIDS_LIMIT=16384
#MEM_LIMIT=64g

# --- プロキシ ---
PROXY_PORT=1080

# このほかに、以下のファイルを手で用意する必要があります（いずれも .gitignore 対象）:
#   ./secrets/mjs_shared_secret      ... クラスタ共通の共有シークレット（mjssetup create-shared-secret）
#   ./certs/proxy-certificate.json   ... 上のシークレットから生成したプロキシ証明書（mjssetup generate-certificate）
#   ./secrets/mjs_admin_pass.txt     ... MJS_ADMIN_USER の LDAP パスワード（1 行のプレーンテキスト）
#   ./certs/ldap-ca.pem              ... (任意) LDAPS サーバ証明書の CA 証明書（PEM）
