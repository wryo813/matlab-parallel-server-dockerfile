# head ノード用の設定例。`.env` にコピーして値を書き換えてください。
# 使い方の詳細は ../../../README.fork.md を参照。

# --- 必須 ---
# authentik LDAP アウトポストのホスト名。未設定だと docker compose がエラー終了します。
LDAP_HOST=ldap.example.internal

# --- クラスタ設定（compute ノードと一致させる必要があるもの） ---
# ジョブマネージャ名。compute 側の JM_NAME と一致必須。
JM_NAME=MyMJS
# MJS セキュリティレベル。compute 側と一致必須（不一致だとワーカーが登録できません）。
SECURITY_LEVEL=2

# --- ホスト設定 ---
# mjs_def.sh の HOSTNAME に書き込まれます。DNS で解決できる名前を指定してください。
FQDN=head.example.internal

# --- LDAP ---
LDAP_PORT=389
# [username] が短いユーザー名に置換されます（角括弧が正式なトークン）。
# authentik 以外のディレクトリを使う場合は base DN を書き換えてください。
LDAP_PRINCIPAL_FORMAT=cn=[username],ou=users,dc=ldap,dc=goauthentik,dc=io
MJS_ADMIN_USER=mjsadmin
# LDAP 同期間隔（秒）。0 は毎アクセス時に同期。
LDAP_SYNC_INTERVAL=1800

# --- プロキシ ---
PROXY_PORT=1080

# このほかに、以下の 2 ファイルを手で用意する必要があります（どちらも .gitignore 対象）:
#   ./certs/proxy-certificate.json   ... matlab-mjs-proxy に渡す証明書
#   ./secrets/mjs_admin_pass.txt     ... MJS_ADMIN_USER の LDAP パスワード（1 行のプレーンテキスト）
