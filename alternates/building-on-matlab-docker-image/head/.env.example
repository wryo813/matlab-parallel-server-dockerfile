# MATLAB Parallel Server head node configuration
# Copy to .env and edit as needed: cp .env.example .env

# Fully qualified domain name of the head node (must resolve from clients/workers)
FQDN=head.matlab.internal

# MATLAB Job Scheduler name
JM_NAME=MyMJS

# SOCKS5 proxy listen port (parallel-server-proxy)
PROXY_PORT=1080
