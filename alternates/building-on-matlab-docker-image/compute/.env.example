# compute ノード用の設定例。`.env` にコピーして値を書き換えてください。
# 使い方の詳細は ../../../README.fork.md を参照。

# --- ホスト設定 ---
# mjs_def.sh の HOSTNAME に書き込まれます。DNS で解決できる名前を指定してください。
FQDN=compute01.example.internal
# 接続先ジョブマネージャ（head ノード）のホスト名。
JM_HOST=head.example.internal

# --- クラスタ設定（head ノードと一致させる必要があるもの） ---
JM_NAME=MyMJS
# head 側と一致必須（不一致だとワーカーがジョブマネージャに登録できません）。
SECURITY_LEVEL=2

# --- ワーカー ---
# このホストで起動するワーカー数。
NUM_WORKERS=4

# --- NFS（docker-compose-wNFS.yml を使う場合のみ）-------------------------
# NFS_ADDR と NFS_EXPORT には既定値がありません。未設定でも compose のパースは通り、
# 実行時のマウントで失敗するので注意してください。
#NFS_ADDR=10.0.0.10
#NFS_EXPORT=/export/matlab
#NFS_MOUNT_PATH=/mnt/nfs
#NFS_VERS=4.1
#NFS_OPTS=rw
